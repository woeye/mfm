{
  "name": "mfm",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "~3.85.0",
    "@payloadcms/db-sqlite": "~3.85.0",
    "@payloadcms/live-preview-react": "~3.85.0",
    "@payloadcms/next": "~3.85.0",
    "@payloadcms/payload-cloud": "~3.85.0",
    "@payloadcms/plugin-mcp": "^3.85.0",
    "@payloadcms/plugin-seo": "~3.85.0",
    "@payloadcms/richtext-lexical": "~3.85.0",
    "@payloadcms/storage-s3": "~3.85.0",
    "@payloadcms/ui": "~3.85.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "17.4.2",
    "graphql": "^16.14.1",
    "justified-layout": "^4.1.0",
    "lightgallery": "^2.9.0",
    "motion": "^12.40.0",
    "next": "^16.2.7",
    "payload": "~3.85.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/bundle-analyzer": "^16.2.7",
    "@next/eslint-plugin-next": "^16.2.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "3.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}